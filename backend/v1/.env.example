# Local development settings for backend/v1.
#
# Copy to `.env` (which is gitignored) and edit. Every value below is a field on
# `app/config.py:Settings`, read case-insensitively from the environment; the
# file is only a convenience for setting them. Real environment variables win
# over this file, and in the deployed Lambda there is no `.env` at all —
# `infra/locals.tf` injects the same names directly. Dot-prefixed files are
# excluded from the Lambda package, so this file never ships.
#
# Nothing here is required: every setting has a default. The one you almost
# certainly want is POSTGRES_NAME.

# --- Environment identity ----------------------------------------------------

# true on a developer machine, false in the deployed Lambda. Setting this to
# false locally switches on TLS to PostgreSQL, Secure cookies and the JWT_SECRET
# strength check, none of which a local setup can satisfy.
# Default: true
IS_LOCAL=true

# Name this application reports for itself. Overwritten in the cloud.
# Default: acme-incidents
#APP_NAME=acme-incidents

# --- Database ----------------------------------------------------------------

# Default: localhost locally; the Aurora endpoint in the cloud, where
# infra/locals.tf sets it to 172.17.0.1 for the Docker bridge case.
#POSTGRES_HOST=localhost

# Default: 5432
#POSTGRES_PORT=5432

# The database the API reads and writes.
#
# THIS IS THE ONE THAT BITES. The default is `postgres`, the cluster's empty
# maintenance database: the API starts, /api/v1/health reports healthy because
# it can connect, and then every query fails on a missing table. Set it to the
# database you migrated — `acme_incidents_dev` if you followed the README.
# Default: postgres
POSTGRES_NAME=acme_incidents_dev

# Default: postgres
#POSTGRES_USER=postgres

# Default: postgres123
#POSTGRES_PASS=postgres123

# Seconds to wait for a connection. Aurora Serverless v2 runs with
# min_capacity = 0 and takes roughly 15 seconds to wake from idle, which is why
# this is far longer than a local database needs.
# Default: 30
#POSTGRES_CONNECT_TIMEOUT=30

# --- Security ----------------------------------------------------------------

# HS256 signing key for access tokens. Leave unset locally: the default is fine
# and is what lets a fresh clone run with no setup. When IS_LOCAL=false the
# application refuses to start unless this is set to something other than the
# default and at least 32 bytes long — see `_reject_a_weak_deployed_secret` in
# app/config.py. In the cloud, infra/locals.tf injects random_password.jwt_secret.
# Default: local-development-secret-change-me
#JWT_SECRET=

# --- Tests -------------------------------------------------------------------

# Not a Settings field: tests/conftest.py reads this directly. The test database
# is DROPPED AND RECREATED on every pytest run, so it must never name a database
# you care about. conftest refuses to drop `postgres`.
# Default: acme_incidents_test
#POSTGRES_TEST_NAME=acme_incidents_test
